{
  "manifest_version": 3,
  "name": "Yano Wallet Connector",
  "version": "0.1.0",
  "description": "Connect Cardano dApps to your Yano full-node desktop wallet (CIP-30). Your keys and node stay in the desktop app.",
  "key": "",
  "icons": {
    "16": "icons/logo-16.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yano Wallet Connector",
    "default_icon": {
      "16": "icons/logo-16.png",
      "48": "icons/logo-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "host_permissions": [
    "ws://127.0.0.1/*",
    "wss://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "nativeMessaging",
    "storage"
  ]
}